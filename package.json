{
  "name": "itsalwaysfun-rental",
  "version": "0.1.0",
  "private": true,
  "description": "Rental inventory management system for It's Always Fun, LLC — bounce house rentals in Jacksonville, FL",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx scripts/seed.ts",
    "supabase:types": "supabase gen types typescript --local > types/database.ts",
    "check:scope": "tsx scripts/check-tenant-scope.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium --with-deps"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@sentry/nextjs": "^8.40.0",
    "@stripe/react-stripe-js": "^2.8.0",
    "@stripe/stripe-js": "^4.7.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "imapflow": "^1.7.6",
    "isomorphic-dompurify": "^2.36.0",
    "lucide-react": "^0.447.0",
    "mailparser": "^3.9.17",
    "next": "14.2.35",
    "next-pwa": "^5.6.0",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "stripe": "^17.0.0",
    "tailwind-merge": "^2.5.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.23",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": "22.x"
  }
}
